          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bDisableVSync:Display",
          "text": "$SkyCore_DisableVSync",
          "help": "$SkyCore_DisableVSync_Help",
          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "iTargetFPS:Display",
          "text": "$SkyCore_TargetFPS",
          "help": "$SkyCore_TargetFPS_Help",
          "type": "slider",
          "valueOptions": {
            "sourceType": "ModSettingInt",
            "min": 0,
            "max": 360,
            "step": 5
          }
        }
      ]
    },
    {
