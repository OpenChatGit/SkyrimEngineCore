{
  "modName": "SkyCore",
  "displayName": "$SkyCore_ModName",
  "minMcmVersion": 9,
  "cursorFillMode": "topToBottom",
  "pages": [
    {
      "pageDisplayName": "$SkyCore_Page_Display",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "text": "$SkyCore_Header_FPS",
          "type": "header"
        },
        {
          "id": "bShowFPS:Display",
          "text": "$SkyCore_ShowFPS",
          "help": "$SkyCore_ShowFPS_Help",
          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "iToggleKey:Display",
          "text": "$SkyCore_ToggleKey",
          "help": "$SkyCore_ToggleKey_Help",
          "type": "keymap",
          "ignoreConflicts": true,
          "valueOptions": {
            "sourceType": "ModSettingInt"
          }
        },
        {
          "text": "$SkyCore_Header_Display",
          "type": "header"
        },
        {
          "id": "bDynamicHavok:Display",
          "text": "$SkyCore_DynamicHavok",
          "help": "$SkyCore_DynamicHavok_Help",
          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bBorderlessFullscreen:Display",
          "text": "$SkyCore_Borderless",
